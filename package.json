{
	"name": "uni_shop",
	"version": "1.0.0",
	"main": "main.js",
	"scripts": {
		"lint": "eslint --ext .js,.vue --fix .",
		"lint:check": "eslint --ext .js,.vue .",
		"format": "prettier --write \"**/*.{js,vue,json,scss,css,md}\"",
		"format:check": "prettier --check \"**/*.{js,vue,json,scss,css,md}\"",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"analyze:size": "node scripts/analyze-bundle.js",
		"prepare": "husky install"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/MrYangMrYangMrYang/uni_shop.git"
	},
	"keywords": [
		"uni-app",
		"mp-weixin",
		"vue2",
		"vuex",
		"ecommerce",
		"vitest",
		"ci-cd",
		"mini-program"
	],
	"author": "Sunny Yang <https://github.com/MrYangMrYangMrYang>",
	"license": "ISC",
	"description": "跨平台电商微信小程序 — 基于 Uni-app + Vuex 的完整购物流程演示",
	"homepage": "https://github.com/MrYangMrYangMrYang/uni_shop#readme",
	"bugs": {
		"url": "https://github.com/MrYangMrYangMrYang/uni_shop/issues"
	},
	"engines": {
		"node": ">=12.0.0"
	},
	"dependencies": {
		"@escook/request-miniprogram": "^0.2.1",
		"vuex": "^3.6.2"
	},
	"devDependencies": {
		"@babel/eslint-parser": "^7.23.0",
		"@commitlint/cli": "^18.4.0",
		"@commitlint/config-conventional": "^18.4.0",
		"@vitejs/plugin-vue2": "^2.3.1",
		"@vue/test-utils": "^1.3.6",
		"eslint": "^8.54.0",
		"eslint-config-prettier": "^9.0.0",
		"eslint-plugin-prettier": "^5.0.1",
		"eslint-plugin-uni-conditional": "file:./eslint-plugin-uni-conditional",
		"eslint-plugin-vue": "^9.9.0",
		"husky": "^8.0.3",
		"jsdom": "^25.0.1",
		"lint-staged": "^15.1.0",
		"prettier": "^3.1.0",
		"sass": "^1.69.0",
		"vitest": "^1.0.0"
	},
	"lint-staged": {
		"*.{js,vue}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,scss,css,md}": [
			"prettier --write"
		]
	}
}
